                </mxCell>
                <mxCell id="07_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1810" width="1800" height="24"/>
                </mxCell>
                <mxCell id="07_note_1" value="Khoản phải thu là nghĩa vụ; phiếu thu là giao dịch thực thu. Mỗi khoản có tối đa một dòng thu được xác nhận." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1835" width="1800" height="24"/>
                </mxCell>
                <mxCell id="07_note_2" value="Yêu cầu thanh toán đủ, không thanh toán từng phần; khoản chưa thu hoặc bị hủy không có dòng thu xác nhận." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1860" width="1800" height="24"/>
                </mxCell>
                <mxCell id="07_note_3" value="Nhật ký thuộc tài khoản thao tác; tác vụ hệ thống có thể không có tài khoản. Phiếu thu luôn có nhân viên thu." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1885" width="1800" height="24"/>
                </mxCell>
                <mxCell id="07_note_4" value="Tiền VND dùng decimal với số lẻ bằng 0; phạt 5.000/cuốn/ngày mở cửa, không giới hạn tối đa." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1910" width="1800" height="24"/>
                </mxCell>
                <mxCell id="07_note_5" value="Trả và thu đủ là luồng chuẩn; thu lỗi sau nhận vật lý lưu nợ, khóa quyền, giữ ngày nhận để đối soát." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1935" width="1800" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
