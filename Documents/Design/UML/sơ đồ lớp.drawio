                <mxCell id="02_note_3" value="Một tài khoản thuộc độc giả hoặc nhân viên; không đồng thời cả hai hồ sơ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
