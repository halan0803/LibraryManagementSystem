                </mxCell>
                <mxCell id="03_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1230" width="1340" height="24"/>
                </mxCell>
                <mxCell id="03_note_1" value="Đầu sách chứa thông tin ấn bản; cuốn sách là từng bản vật lý, có mã riêng và tình trạng riêng." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1255" width="1340" height="24"/>
                </mxCell>
                <mxCell id="03_note_2" value="Mỗi đầu sách thuộc một thể loại trong mô hình hiện tại. Cuốn thanh lý không còn vị trí kệ hiện hành." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1280" width="1340" height="24"/>
                </mxCell>
                <mxCell id="03_note_3" value="Giá bìa/định giá trên cuốn là căn cứ bồi thường; giá trên đầu sách chỉ dùng làm giá tham khảo." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1305" width="1340" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
