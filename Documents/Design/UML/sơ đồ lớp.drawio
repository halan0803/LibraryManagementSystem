                </mxCell>
                <mxCell id="06_Receivable_head" value="&lt;b&gt;Khoản phải thu&lt;br/&gt;Receivable&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#45525E;strokeWidth=1.2;fontFamily=Arial;fontSize=15;fontColor=#1F2933;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=0;connectable=0;" vertex="1" parent="06_Receivable" connectable="0">
                    <mxGeometry as="geometry" x="0" y="0" width="340" height="60"/>
                </mxCell>
                <mxCell id="06_Receivable_attrs" value="- mãKhoản: string&lt;br/&gt;- loại: Phạt / BồiThường&lt;br/&gt;- sốTiềnChốt: decimal&lt;br/&gt;- trạngThái: enum&lt;br/&gt;- ngàyChốt: DateOnly?&lt;br/&gt;- cáchTấtToán: enum?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45525E;strokeWidth=1.2;fontFamily=Arial;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;connectable=0;" vertex="1" parent="06_Receivable" connectable="0">
                    <mxGeometry as="geometry" x="0" y="60" width="340" height="148"/>
                </mxCell>
                <mxCell id="06_Receivable_methods" value="+ sốTiềnCònNợ(): decimal&lt;br/&gt;+ chốtSốTiền(sốTiền: decimal, ngày: DateOnly):&lt;br/&gt;void&lt;br/&gt;+ xácNhậnThuĐủ(sốTiền: decimal): void&lt;br/&gt;+ tấtToánBằngBảnThayThế(biênNhận:&lt;br/&gt;ReplacementReceipt): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45525E;strokeWidth=1.2;fontFamily=Arial;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;connectable=0;" vertex="1" parent="06_Receivable" connectable="0">
                    <mxGeometry as="geometry" x="0" y="208" width="340" height="152"/>
                </mxCell>
                <mxCell id="06_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1910" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_1" value="Hao mòn: không bồi thường. Hư nhẹ: 50% giá bìa/định giá, chỉ nhận tiền. Hư nặng/mất: 100% hoặc bản tương đương được duyệt." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1935" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_2" value="Hai liên kết cuốn cũ/cuốn mới của biên nhận có vai trò khác nhau; cuốn thay thế luôn có mã mới." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1960" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_3" value="Một mã cuốn xuất hiện một lần trong sơ đồ, không nhân đôi đối tượng khi vẽ hai vai trò." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1985" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_4" value="Thanh lý không xóa lịch sử; biên bản sự cố và khoản phạt là các hồ sơ độc lập." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="2010" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_5" value="Báo mất không dừng phạt: chốt đến ngày thanh toán phạt; bản đã bồi thường tìm lại thuộc người đọc." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="2035" width="1800" height="24"/>
                </mxCell>
                <mxCell id="06_note_6" value="Bản thay thế phải được duyệt đúng tên, tác giả, ngôn ngữ; không dùng phiếu thu tiền cho bản thay thế." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="2060" width="1800" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
