                <mxCell id="04_Receivable_attrs" value="- mãKhoản: string&lt;br/&gt;- loại: Phạt / BồiThường&lt;br/&gt;- sốTiềnChốt: decimal&lt;br/&gt;- trạngThái: enum&lt;br/&gt;- ngàyChốt: DateOnly?&lt;br/&gt;- cáchTấtToán: enum?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45525E;strokeWidth=1.2;fontFamily=Arial;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;connectable=0;" vertex="1" parent="04_Receivable" connectable="0">
