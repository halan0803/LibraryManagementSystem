                </mxCell>
                <mxCell id="05_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1870" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_1" value="Hàng chờ thuộc một cuốn cụ thể. Mỗi độc giả tối đa một đăng ký chờ hiệu lực trên toàn thư viện." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1895" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_2" value="Mỗi đợt có 1–2 lượt, chỉ một lượt có quyền nhận; không có ứng viên thì không tạo đợt." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1920" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_3" value="Người 1 mượn thành công: kiểm tra lại người 2 theo lượt mượn mới cộng 21/37 ngày mở cửa." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1945" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_4" value="Người thiếu điều kiện kết thúc đăng ký; vẫn giữ bản ghi lịch sử, không giữ vị trí cho đợt sau." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1970" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_5" value="Hai ngày nhận tính riêng từng lượt theo ngày mở cửa; hết hai lượt thì đưa cuốn về sẵn sàng." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1995" width="1340" height="24"/>
                </mxCell>
                <mxCell id="05_note_6" value="Sách hỏng: thông báo và chờ bản bổ sung; chuyển đăng ký giữ thứ tự cũ và lưu dấu vết." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="2020" width="1340" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
