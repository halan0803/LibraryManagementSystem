                <mxCell id="08_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3070" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_1" value="Nét đứt mũi tên mở: phụ thuộc. Nét đứt tam giác rỗng: hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3095" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_2" value="Mỗi service sử dụng repository đều nối đến IRepository&amp;lt;T&amp;gt;; kiểu T cụ thể được ghi tại thuộc tính." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3120" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_3" value="ReportService chỉ đọc dữ liệu; ClosureService kiểm tra phiếu mượn và khoản nợ trước khi đóng hồ sơ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3145" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_4" value="IUnitOfWork thể hiện các giao dịch mượn, trả, thu tiền và đóng hồ sơ cần nhất quán." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3170" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_5" value="InventoryService hiện thực IBookInventory; các service sử dụng interface chỉ mang mũi tên phụ thuộc." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3195" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_6" value="Các lớp chính sách và lịch đã có hiện thực; cổng nhà trường là hợp đồng tích hợp, không giả định API đã triển khai." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3220" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_7" value="BorrowPolicy kiểm tra thẻ, quyền, nợ, hạn mức, hàng chờ và điều kiện gia hạn; List&amp;lt;string&amp;gt; rỗng nghĩa là hợp lệ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3245" width="3180" height="24"/>
                </mxCell>
                <mxCell id="08_note_8" value="Lịch: thứ Hai–thứ Bảy mở cửa, Chủ nhật nghỉ; ngoại lệ cấu hình riêng; cộng ngày không tính ngày bắt đầu." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="3270" width="3180" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
