                <mxCell id="04_Receivable_methods" value="+ sốTiềnCònNợ(): decimal&lt;br/&gt;+ chốtSốTiền(sốTiền: decimal, ngày: DateOnly):&lt;br/&gt;void&lt;br/&gt;+ xácNhậnThuĐủ(sốTiền: decimal): void&lt;br/&gt;+ tấtToánBằngBảnThayThế(biênNhận:&lt;br/&gt;ReplacementReceipt): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45525E;strokeWidth=1.2;fontFamily=Arial;fontSize=14;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;connectable=0;" vertex="1" parent="04_Receivable" connectable="0">
                    <mxGeometry as="geometry" x="0" y="208" width="340" height="152"/>
                </mxCell>
                <mxCell id="04_note_0" value="Ký hiệu: tam giác rỗng = kế thừa; thoi đặc = composition; nét đứt = phụ thuộc hoặc hiện thực interface." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1290" width="1340" height="24"/>
                </mxCell>
                <mxCell id="04_note_1" value="Một phiếu gồm nhiều dòng; từng dòng có hạn trả, tình trạng và lần gia hạn độc lập." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1315" width="1340" height="24"/>
                </mxCell>
                <mxCell id="04_note_2" value="Gia hạn một lần, chọn 3/5/7 ngày mở cửa; thẻ còn hạn, không nợ, không có người chờ cuốn đó." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1340" width="1340" height="24"/>
                </mxCell>
                <mxCell id="04_note_3" value="Phụ thuộc từ Loan tới LibraryCard thể hiện việc kiểm tra khi lập phiếu, không phải thẻ sở hữu phiếu." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1365" width="1340" height="24"/>
                </mxCell>
                <mxCell id="04_note_4" value="Thẻ hết hạn trong lúc mượn không đổi hạn trả cũ; trả từng cuốn, ưu tiên người chờ trước khi cho mượn lại." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1390" width="1340" height="24"/>
                </mxCell>
                <mxCell id="04_note_5" value="Trạng thái dòng: DANG_MUON, DA_NHAN, BAO_MAT, HOAN_TAT; ngày nhận vật lý khác ngày hoàn tất nghĩa vụ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#263238;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
                    <mxGeometry as="geometry" x="100" y="1415" width="1340" height="24"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
